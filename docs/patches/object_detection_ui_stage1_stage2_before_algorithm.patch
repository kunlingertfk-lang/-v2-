+        return;
+    }
+
+    bool ok = false;
+    const QString name = QInputDialog::getText(this,
+                                               tr("编辑方案名"),
+                                               tr("方案名"),
+                                               QLineEdit::Normal,
+                                               store.currentSchemeName(),
+                                               &ok);
+    if (!ok || name.trimmed().isEmpty())
+        return;
+
+    store.setSchemeName(name);
+    commitToolStateToScheme(true);
+}
