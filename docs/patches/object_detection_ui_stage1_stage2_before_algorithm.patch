+    case ToolType::CirclePresence:
+        return tr("圆有无");
+    case ToolType::EdgePresence:
+        return tr("边缘有无");
+    case ToolType::LinePresence:
+        return tr("直线有无");
+    case ToolType::ContourPresence:
+        return tr("轮廓有无");
+    case ToolType::AiDetection:
+        return tr("目标检测");
+    default:
+        return toolTypeToString(config.toolType);
