include($$TOOLS_DIALOG_ACTIONS_ROOT/qt_ui_test.pro)

TARGET = tools_dialog_actions_smoke
DESTDIR = $$BUILD_ROOT/bin
SOURCES -= src/main.cpp
SOURCES += $$TOOLS_DIALOG_ACTIONS_ROOT/smoke/tools_dialog_actions_smoke.cpp

TOOLS_DIALOG_ACTIONS_SOURCES =
for(file, SOURCES): TOOLS_DIALOG_ACTIONS_SOURCES += $$absolute_path($$file, $$TOOLS_DIALOG_ACTIONS_ROOT)
