TOOLS_DIALOG_ACTIONS_HEADERS =
for(file, HEADERS): TOOLS_DIALOG_ACTIONS_HEADERS += $$absolute_path($$file, $$TOOLS_DIALOG_ACTIONS_ROOT)
HEADERS = $$TOOLS_DIALOG_ACTIONS_HEADERS

TOOLS_DIALOG_ACTIONS_FORMS =
for(file, FORMS): TOOLS_DIALOG_ACTIONS_FORMS += $$absolute_path($$file, $$TOOLS_DIALOG_ACTIONS_ROOT)
FORMS = $$TOOLS_DIALOG_ACTIONS_FORMS

TOOLS_DIALOG_ACTIONS_RESOURCES =
for(file, RESOURCES): TOOLS_DIALOG_ACTIONS_RESOURCES += $$absolute_path($$file, $$TOOLS_DIALOG_ACTIONS_ROOT)
RESOURCES = $$TOOLS_DIALOG_ACTIONS_RESOURCES

INCLUDEPATH = $$TOOLS_DIALOG_ACTIONS_ROOT/src $$INCLUDEPATH
