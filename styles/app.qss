    padding: 4px 12px;
    font-size: 17px;
    font-weight: 600;
}

QDialog#ColorTemplateDialog[toolLevelStyle="true"] QFrame[panelRole="configCard"] QPushButton:hover,
QDialog#ColorTemplateDialog[toolLevelStyle="true"] QPushButton#cancelButton:hover {
    background: #eff6ff;
    border-color: #60a5fa;
}

QDialog#ColorTemplateDialog[toolLevelStyle="true"] QPushButton#saveTemplateButton {
    min-height: 42px;
    background: #ff720d;
    color: #ffffff;
    border: 2px solid #ea580c;
    border-radius: 4px;
    padding: 4px 18px;
    font-size: 17px;
    font-weight: 800;
}

QDialog#ColorTemplateDialog[toolLevelStyle="true"] QPushButton#saveTemplateButton:hover {
    background: #f97316;
}

QDialog#ColorTemplateDialog[toolLevelStyle="true"] QListWidget,
QDialog#ColorTemplateDialog[toolLevelStyle="true"] QLabel#sampleCountLabel {
    background: #eef2f6;
    color: #0f172a;
    border: 2px solid #93c5fd;
    border-radius: 4px;
    font-size: 17px;
}

QDialog#ColorTemplateDialog[toolLevelStyle="true"] QListWidget::item:selected {
    background: #fff7ed;
    color: #ea580c;
    border: 2px solid #f97316;
}

/* Shared position-correction switch; opt-in tool pages only. */
QDialog[toolLevelStyle="true"] QCheckBox#basicPositionCorrectionSwitch,
QDialog[toolLevelStyle="true"] QCheckBox#positionCorrectionSwitch,
QDialog[toolLevelStyle="true"] QCheckBox#allPositionCorrectionSwitch {
    min-width: 54px;
    max-width: 54px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
    spacing: 0;
    background: transparent;
    border: 0;
}

QDialog[toolLevelStyle="true"] QCheckBox#basicPositionCorrectionSwitch::indicator,
QDialog[toolLevelStyle="true"] QCheckBox#positionCorrectionSwitch::indicator,
QDialog[toolLevelStyle="true"] QCheckBox#allPositionCorrectionSwitch::indicator {
    width: 54px;
    height: 28px;
    image: url(:/icons/toggle-off.svg);
    border: 0;
    background: transparent;
}

QDialog[toolLevelStyle="true"] QCheckBox#basicPositionCorrectionSwitch::indicator:checked,
QDialog[toolLevelStyle="true"] QCheckBox#positionCorrectionSwitch::indicator:checked,
QDialog[toolLevelStyle="true"] QCheckBox#allPositionCorrectionSwitch::indicator:checked {
    image: url(:/icons/toggle-on.svg);
}
