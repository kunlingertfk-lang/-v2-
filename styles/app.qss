/* ColorComparisonDialog: keep the dialog independent from the global dark palette. */
QDialog#ColorComparisonDialog {
    background: #ffffff;
    color: #0f172a;
    font-size: 18px;
}

QFrame#colorComparisonHeader {
    min-height: 58px;
    background: #3f444e;
    border: none;
}

QDialog#ColorComparisonDialog QLabel#colorComparisonHeaderTitle {
    background: transparent;
    color: #ffffff;
    font-size: 26px;
    font-weight: 800;
}

QDialog#ColorComparisonDialog QToolButton#colorComparisonHeaderClose {
    min-width: 40px;
    min-height: 40px;
    background: transparent;
    color: #ffffff;
    border: none;
    border-radius: 4px;
    font-size: 26px;
    font-weight: 700;
}

QDialog#ColorComparisonDialog QToolButton#colorComparisonHeaderClose:hover {
    background: #ef4444;
}

QFrame#colorComparisonLeftPanel,
QScrollArea#colorComparisonParamsScrollArea,
QStackedWidget#colorComparisonParamsStack {
    background: #eef1f5;
    color: #0f172a;
    border: none;
}

QDialog#ColorComparisonDialog QScrollArea#colorComparisonParamsScrollArea QWidget {
    background: transparent;
    color: #0f172a;
}

QDialog#ColorComparisonDialog QFrame[panelRole="configCard"] {
    background: #ffffff;
    border: 2px solid #93c5fd;
    border-radius: 8px;
}

QDialog#ColorComparisonDialog QLabel {
    background: transparent;
    color: #0f172a;
    font-size: 18px;
}

QDialog#ColorComparisonDialog QLabel[role="cardTitle"] {
    color: #0f172a;
    font-size: 22px;
    font-weight: 800;
}

QDialog#ColorComparisonDialog QLabel[role="rowField"] {
    color: #0f172a;
    font-size: 18px;
    font-weight: 700;
}

QDialog#ColorComparisonDialog QCheckBox#colorComparisonBrightnessCompensation {
    spacing: 8px;
    background: transparent;
    color: #0f172a;
    font-size: 18px;
}

QDialog#ColorComparisonDialog QCheckBox#colorComparisonBrightnessCompensation::indicator {
    width: 18px;
    height: 18px;
    background: #ffffff;
    border: 2px solid #60a5fa;
    border-radius: 3px;
}

QDialog#ColorComparisonDialog QCheckBox#colorComparisonBrightnessCompensation::indicator:checked {
    background: #f97316;
    border-color: #f97316;
}

QDialog#ColorComparisonDialog QPushButton,
QDialog#ColorComparisonDialog QToolButton,
QDialog#ColorComparisonDialog QComboBox,
QDialog#ColorComparisonDialog QSpinBox {
    min-height: 38px;
    background: #ffffff;
    color: #0f172a;
    border: 2px solid #93c5fd;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 18px;
    font-weight: 600;
}

/* Public semantic roles: combo popup views may be reparented to a top-level
   Qt popup, so these selectors must not depend on a dialog ancestor. */
QComboBox[uiRole="lightField"] {
    min-height: 38px;
    background: #ffffff;
    color: #0f172a;
    border: 2px solid #93c5fd;
    border-radius: 4px;
    padding: 4px 8px;
    font-size: 18px;
    font-weight: 600;
}

QComboBox[uiRole="lightField"]:focus,
QComboBox[uiRole="lightField"]:on {
    border-color: #f97316;
}

QWidget#sharedLightComboPopupContainer,
QWidget#sharedLightComboPopupViewport,
QAbstractItemView#sharedLightComboPopup,
QWidget[uiRole="lightComboPopupContainer"],
QWidget[uiRole="lightComboPopupViewport"],
QAbstractItemView[uiRole="lightComboPopup"],
QComboBox[uiRole="lightField"] QAbstractItemView {
    background: #ffffff;
    color: #0f172a;
}

QAbstractItemView#sharedLightComboPopup,
QAbstractItemView[uiRole="lightComboPopup"],
QComboBox[uiRole="lightField"] QAbstractItemView {
    border: 2px solid #60a5fa;
    border-radius: 3px;
    outline: 0;
    font-size: 18px;
    font-weight: 600;
    selection-background-color: #ffedd5;
    selection-color: #9a3412;
}

QAbstractItemView#sharedLightComboPopup::item,
QAbstractItemView[uiRole="lightComboPopup"]::item,
QComboBox[uiRole="lightField"] QAbstractItemView::item {
    min-height: 38px;
    padding: 4px 10px;
    background: #ffffff;
    color: #0f172a;
}

QAbstractItemView#sharedLightComboPopup::item:hover,
QAbstractItemView[uiRole="lightComboPopup"]::item:hover,
QComboBox[uiRole="lightField"] QAbstractItemView::item:hover {
    background: #eff6ff;
    color: #0f172a;
}

QAbstractItemView#sharedLightComboPopup::item:selected,
QAbstractItemView[uiRole="lightComboPopup"]::item:selected,
QComboBox[uiRole="lightField"] QAbstractItemView::item:selected {
    background: #ffedd5;
    color: #9a3412;
}

QAbstractItemView#sharedLightComboPopup::item:disabled,
QAbstractItemView[uiRole="lightComboPopup"]::item:disabled,
QComboBox[uiRole="lightField"] QAbstractItemView::item:disabled {
    background: #f1f5f9;
    color: #64748b;
}

