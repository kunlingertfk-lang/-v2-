}

QDialog#ColorComparisonDialog QPushButton[actionRole="testAction"][running="true"] {
    background: #f97316;
    color: #ffffff;
    border-color: #f97316;
}

QDialog#ColorComparisonDialog QPushButton[actionRole="testPrimary"]:disabled,
QDialog#ColorComparisonDialog QPushButton[actionRole="testAction"]:disabled,
