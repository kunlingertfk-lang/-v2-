    border-radius: 8px;
}

QDialog#ColorComparisonDialog QLabel[role="featureZoomTitle"] {
    background: transparent;
    color: #0f172a;
    font-size: 22px;
    font-weight: 800;
}

QDialog#ColorComparisonDialog QLabel[role="featureZoomDetails"] {
    background: #ffffff;
    color: #334155;
    border-top: 1px solid #bfdbfe;
    padding: 10px 14px;
    font-size: 18px;
}

QDialog#ColorComparisonDialog QPushButton[actionRole="featureZoomClose"] {
    min-height: 44px;
    background: #ef4444;
    color: #ffffff;
    border: 2px solid #dc2626;
    border-radius: 5px;
    padding: 4px 14px;
    font-size: 20px;
    font-weight: 700;
}

QDialog#ColorComparisonDialog QPushButton[actionRole="featureZoomClose"]:hover {
    background: #dc2626;
}

QLabel[statusTone="neutral"] {
    color: #64748b;
}

QLabel[statusTone="building"],
QLabel[statusTone="warning"],
QLabel[statusTone="stale"] {
    color: #d97706;
    font-weight: 600;
}

QLabel[statusTone="success"] {
    color: #15803d;
    font-weight: 600;
}

QLabel[statusTone="error"] {
    color: #dc2626;
    font-weight: 600;
}

/* TemplateLocation: utility-first industrial editor, light controls + dark canvas. */
QDialog#TemplateLocationDialog {
    background: #171a20;
}

QDialog#TemplateLocationDialog QFrame#titleBar,
QDialog#TemplateLocationDialog QFrame#viewerHeader,
QDialog#TemplateLocationDialog QFrame#resultBar {
    background: #20242c;
    color: #f8fafc;
}

QDialog#TemplateLocationDialog QFrame#parameterPanel,
QDialog#TemplateLocationDialog QScrollArea#parameterScrollArea,
QDialog#TemplateLocationDialog QWidget#parameterScrollContents,
QDialog#TemplateLocationDialog QScrollArea#parameterScrollArea QWidget#qt_scrollarea_viewport {
    background: #eef2f6;
    color: #334155;
}

QDialog#TemplateLocationDialog QFrame#parameterPanel QLabel {
    background: transparent;
    color: #475569;
}

QDialog#TemplateLocationDialog QSpinBox,
QDialog#TemplateLocationDialog QDoubleSpinBox {
    min-height: 36px;
    background: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 2px 8px;
}

QDialog#TemplateLocationDialog QSpinBox:focus,
QDialog#TemplateLocationDialog QDoubleSpinBox:focus {
    border: 2px solid #f97316;
}

QDialog#TemplateLocationDialog QLabel[autoParameter="true"]:disabled {
    color: #374151;
    font-weight: 600;
}

QDialog#TemplateLocationDialog QSpinBox[autoParameter="true"]:disabled {
    background: #c1c7d0;
    color: #374151;
    border-color: #6b7280;
}

QDialog#TemplateLocationDialog QPushButton {
    min-height: 38px;
    background: #ffffff;
    color: #334155;
    border: 1px solid #cbd5e1;
    border-radius: 4px;
    padding: 0 14px;
    font-weight: 600;
}

QDialog#TemplateLocationDialog QPushButton:checked {
    background: #fff7ed;
    color: #ea580c;
    border-color: #f97316;
}

/* ROI mode must remain unmistakable after clicking, including during redraw. */
QDialog#TemplateLocationDialog QToolButton#templateRectButton:checked,
QDialog#TemplateLocationDialog QToolButton#templatePolygonButton:checked,
QDialog#TemplateLocationDialog QToolButton#searchGlobalButton:checked,
QDialog#TemplateLocationDialog QToolButton#searchRectButton:checked,
QDialog#TemplateLocationDialog QToolButton#searchCircleButton:checked,
QDialog#TemplateLocationDialog QToolButton#searchPolygonButton:checked {
    background: #fed7aa;
    border: 3px solid #ea580c;
    color: #7c2d12;
}

QDialog#TemplateLocationDialog QToolButton#templateRectButton:checked:hover,
QDialog#TemplateLocationDialog QToolButton#templatePolygonButton:checked:hover,
QDialog#TemplateLocationDialog QToolButton#searchGlobalButton:checked:hover,
QDialog#TemplateLocationDialog QToolButton#searchRectButton:checked:hover,
QDialog#TemplateLocationDialog QToolButton#searchCircleButton:checked:hover,
QDialog#TemplateLocationDialog QToolButton#searchPolygonButton:checked:hover {
    background: #fdba74;
    border-color: #c2410c;
}

QDialog#TemplateLocationDialog QPushButton#createTemplateButton,
QDialog#TemplateLocationDialog QPushButton#finishButton {
    background: #f97316;
    color: #ffffff;
    border-color: #ea580c;
}

QDialog#TemplateLocationDialog QFrame#previewPanel,
QDialog#TemplateLocationDialog QGraphicsView#previewGraphicsView {
    background: #000000;
}

QDialog#TemplateLocationDialog QTableWidget#matchResultTable {
    background: #171a20;
    alternate-background-color: #20242c;
    color: #e5e7eb;
    border: 1px solid #475569;
    gridline-color: #475569;
    selection-background-color: #9a3412;
    selection-color: #ffffff;
}

QDialog#TemplateLocationDialog QFrame#matchResultDrawer {
    background: #20242c;
    border-top: 1px solid #475569;
}

QDialog#TemplateLocationDialog QPushButton#matchResultToggle {
    min-height: 36px;
    max-height: 36px;
    background: #2b313b;
    color: #f8fafc;
    border: 0;
    border-radius: 0;
    padding: 0 14px;
    text-align: left;
    font-weight: 600;
}

QDialog#TemplateLocationDialog QPushButton#matchResultToggle:hover,
QDialog#TemplateLocationDialog QPushButton#matchResultToggle:checked {
    background: #374151;
    color: #ffffff;
    border: 0;
}

QDialog#TemplateLocationDialog QTableWidget#matchResultTable QHeaderView::section {
    min-height: 30px;
    background: #2b313b;
    color: #f8fafc;
    border: 0;
    border-right: 1px solid #475569;
    border-bottom: 1px solid #64748b;
    font-weight: 600;
}

QDialog#TemplateLocationDialog QFrame#viewerHeader QLabel,
QDialog#TemplateLocationDialog QFrame#resultBar QLabel,
QDialog#TemplateLocationDialog QFrame#titleBar QLabel {
    background: transparent;
    color: #f8fafc;
}
