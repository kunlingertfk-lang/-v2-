      font-size: 16px;
  }
  QPushButton[navButton=&quot;true&quot;] {
      border: 0;
      border-radius: 0;
      background: #ffffff;
      color: #3f4652;
      text-align: left;
      padding-left: 42px;
      min-height: 48px;
      font-size: 17px;
  }
  QPushButton[navButton=&quot;true&quot;]:checked {
      color: #ff7a00;
      background: #eef1f4;
      border-right: 2px solid #ff7a00;
  }
  QLabel[sidebarGroup=&quot;true&quot;] {
      color: #3f4652;
