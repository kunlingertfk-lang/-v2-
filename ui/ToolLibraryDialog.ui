      border: 0;
  }
  QLabel[categoryTitle=&quot;true&quot;] {
      color: #3f4652;
      font-size: 17px;
      font-weight: 600;
      padding: 8px 0 0 0;
  }
  QToolButton[toolCard=&quot;true&quot;] {
      background: #ffffff;
      border: 1px solid transparent;
      border-radius: 2px;
      color: #4a5360;
      font-size: 16px;
      padding: 8px;
  }
  QToolButton[toolCard=&quot;true&quot;]:hover, QToolButton[toolCard=&quot;true&quot;]:checked {
      border: 1px solid #ff7a00;
      color: #ff7a00;
      background: #fff7f0;
  }
  QFrame#toolPreviewGraphic {
